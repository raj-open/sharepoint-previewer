# ----------------------------------------------------------------
# WHITELIST PATTERN: ignore everything, then include explicitly
# ----------------------------------------------------------------

/**

# --------------------------------
# root files
# --------------------------------

!/.gitignore
!/LICENCE
!/README.md
!/NOTES.md
!/specs.md
!/justfile
!/package.json
!/package-lock.json
!/biome.json
!/tsconfig.json

# --------------------------------
# folders
# --------------------------------

!/.github
!/.github/**

!/demos
!/demos/**

!/dist
!/dist/VERSION

!/src
!/src/**

!/tests
!/tests/**

!/scripts
!/scripts/**

!/models
!/models/**

!/templates
!/templates/**

# ----------------------------------------------------------------
# ARTEFACTS
# ----------------------------------------------------------------

**/node_modules
**/__archive__*
**/.DS_Store
**/Thumbs.db

# ----------------------------------------------------------------
# FORCE INCLUDE
# ----------------------------------------------------------------

!**/.gitkeep
