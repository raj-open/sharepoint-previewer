# ----------------------------------------------------------------
# ENVIRONMENT (local only; copied to /.env by `just setup`)
# ----------------------------------------------------------------

# name of the built userscript in /dist
NAME="sharepoint-previewer"

# local port of the explorative tests (`just tests-explore`)
HTTP_PORT=8080

# browser of the behavioural tests: empty = Playwright's Chromium (downloaded by `just build-deps`);
# else an installed one, e.g. chrome, msedge (nothing downloaded)
BROWSER_CHANNEL=

# 3D files (ifc-lite) in the release folder: true or false
# (false: built in a temporary folder only, for their hashes in the userscript)
BUILD_3D=true
