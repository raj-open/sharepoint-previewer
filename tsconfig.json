{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "lib": ["es2022", "dom", "dom.iterable"],
        "types": [],
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/@apis/**"]
}
