{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2022", "dom", "dom.iterable"],
        "types": [],
        "skipLibCheck": true
    },
    "include": ["src/**/*.js", "src/**/*.d.ts"],
    "exclude": ["src/main.js", "src/main.min.js", "src/@apis/**"]
}
